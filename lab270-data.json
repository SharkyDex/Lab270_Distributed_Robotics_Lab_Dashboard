  "projects": [
    {
      "title": "SwarmNav: Decentralized navigation for robot swarms",
      "description": "Developing distributed planning algorithms for 10+ robot teams operating in GPS-denied environments using only local sensor data.",
      "members": [
        "Carlos Reyes",
        "Kwame Asante"
      ],
      "status": "active",
      "photo": ""
    },
    {
      "title": "TactileGrasp: Sim-to-real manipulation learning",
      "description": "Training dexterous manipulation policies in simulation and transferring to physical robot arms using domain randomization.",
      "members": [
        "Lena Fischer",
        "Dr. Mart\u00ednez"
      ],
      "status": "active",
      "photo": ""
    },
    {
      "title": "SLAM++ for dynamic environments",
      "description": "Extending SLAM algorithms to handle moving objects in indoor warehouse scenarios.",
      "members": [
        "Priya Nair"
      ],
      "status": "active",
      "photo": ""
    },
    {
